<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>damiao_hw</name>
  <version>0.0.0</version>
  <description>A hardware interface of DaMiao Motor</description>
  <maintainer email="yerik5827@gmail.com">yerik</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>pkg-config</build_depend>
  <build_depend>libusb-1.0-0-dev</build_depend>
  <build_depend>libudev-dev</build_depend>
  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>controller_manager</depend> 
  <depend>rclcpp_components</depend> 
  <exec_depend>libusb-1.0-0-dev</exec_depend>
  <exec_depend>libudev-dev</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/dm_hw_plugins.xml"/> <!-- 定义一个插件描述文件 -->
  </export>

</package>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="damiao_test_robot">
  <xacro:include filename="$(find damiao_description)/ros2_control/damiao.ros2_control.xacro"/>

  <xacro:property name="motors_config" value="${xacro.load_yaml('$(find damiao_description)/config/motors.yaml')}"/>
  <xacro:property name="joint_names" value="${list(motors_config.keys())}"/>

  <xacro:macro name="damiao_dummy_chain" params="joint_names parent_link index:=1">
    <xacro:if value="${joint_names}">
      <xacro:property name="joint_name" value="${joint_names[0]}"/>
      <xacro:property name="child_link" value="${'link_' + str(index)}"/>

      <link name="${child_link}"/>
      <joint name="${joint_name}" type="revolute">
        <parent link="${parent_link}"/>
        <child link="${child_link}"/>
        <origin xyz="0 0 ${0.1 * index}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="30"/>
      </joint>

      <xacro:damiao_dummy_chain joint_names="${joint_names[1:]}" parent_link="${child_link}" index="${index + 1}"/>
    </xacro:if>
  </xacro:macro>

  <link name="base_link"/>
  <xacro:damiao_dummy_chain joint_names="${joint_names}" parent_link="base_link"/>

  <xacro:damiao/>
</robot>
